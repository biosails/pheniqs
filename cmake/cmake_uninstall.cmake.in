## cmake_uninstall.cmake.in
# Generated by CMake configure step.  This script removes files listed
# in the install manifest created during `cmake --install`.

set(_install_manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${_install_manifest}")
    # Fallback: some workflows place the manifest in the install prefix
    if(EXISTS "@CMAKE_INSTALL_PREFIX@/install_manifest.txt")
        set(_install_manifest "@CMAKE_INSTALL_PREFIX@/install_manifest.txt")
    endif()
endif()

if(NOT EXISTS "${_install_manifest}")
    message(WARNING "install_manifest.txt not found (looked at ${_install_manifest}); nothing to uninstall")
else()
    file(READ "${_install_manifest}" _manifest)
    string(REGEX REPLACE "\r?\n$" "" _manifest "${_manifest}")
    string(REGEX REPLACE "\r?\n" ";" _files "${_manifest}")
    foreach(_f ${_files})
        if(EXISTS "${_f}")
            message(STATUS "Uninstalling ${_f}")
            file(REMOVE_RECURSE "${_f}")
        else()
            message(STATUS "Skipping missing file ${_f}")
        endif()
    endforeach()
endif()
